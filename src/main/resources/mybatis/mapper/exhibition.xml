<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.artissue.model.ExhibitionMapper">

    <select id="getExhibitionsList" parameterType="map" resultType="exhibitionDTO">
        SELECT * FROM exhibition
        where 1=1
        <if test="keyword != null and keyword != ''">
            and exhibition_title like CONCAT('%', #{keyword}, '%')
        </if>
        <if test="sellCodes != null and !sellCodes.isEmpty()">
            AND (
            <foreach item="sellCode" collection="sellCodes" open="" separator=" OR " close="">
                <choose>
                    <when test="sellCode == '판매중'">
                        <![CDATA[exhibition_start_date <= now() AND exhibition_end_date >= now()]]>
                    </when>
                    <when test="sellCode == '판매예정'">
                        <![CDATA[exhibition_start_date > now()]]>
                    </when>
                    <when test="sellCode == '판매종료'">
                        <![CDATA[exhibition_end_date < now()]]>
                    </when>
                </choose>
            </foreach>
            )
        </if>
        <if test="locCodes != null and !locCodes.isEmpty()">
            AND (
            <foreach item="loc" collection="locCodes" open="" separator=" OR " close="">
                exhibition_addr LIKE CONCAT('%', #{loc}, '%')
            </foreach>
            )
        </if>
        order by exhibition_start_date desc LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="getExhibitionCont" parameterType="int" resultType="exhibitionDTO">
        select * from exhibition where exhibition_key = #{no}
    </select>

</mapper>
